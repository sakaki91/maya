#!/bin/bash

NAME="peaclock"
VERSION="git"
DESCRIPTION="A responsive and customizable clock, timer, and stopwatch for the terminal."
SOURCE="https://github.com/octobanana/peaclock"
TYPE="system"
DEPENDENCIES=(
    "gcc"
    "cmake"
)

function install(){
	git clone $SOURCE /tmp/maya/$NAME
    (
        cd /tmp/maya/$NAME
        ./RUNME.sh build
        ./RUNME.sh install
    )
}

function remove(){
    rm -f /usr/local/bin/peaclock
}
