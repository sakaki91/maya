MAYA_VERSION=1.6
MAYA_TREE=/usr/local/share/maya

function rootCheck(){
	[[ $EUID != 0 ]] && printf "\e[0;91merror:\e[0m you can't run this without root access.\n" && exit
}

function binaryExCheck(){
	[[ -z $1 ]] && printf "\e[0;91merror:\e[0m empty value.\n" && exit
	[[ ! -f "$MAYA_TREE/pkg/$1" ]] && printf "\e[0;91merror:\e[0m the package does not exist.\n" && exit
}

function dependencieCheck(){
	if [[ ! -z $DEPENDENCIES ]]; then
        for dep in "${DEPENDENCIES[@]}"; do
	    	if ! command -v "$dep" &>> /dev/null; then
        	    printf "\e[0;91merror:\033[0m $dep is not installed.\n" && exit
	        fi
        done
    fi
}

case $1 in
	"--help"|"-h")
		printf "\e[1musage: maya 'operation' [...]\n\e[4moperations:\e[0m\n" 
		printf "%-20s %0s\n" " -h, --help" "show this message."
	    printf "%-20s %0s\n\n" " -v, --version" "shows the version."
        printf "%-35s %0s\n" " -a,  --about" "view the metadata (version, name, and description) of a package."
	    printf "%-35s %0s\n" " -l,  --list" "shows all available binaries for installation."
        printf "\e[2m%-35s\e[0m %0s\n" "      --list <package>" "filters the available binaries for installation."
        printf "%-35s %0s\n" " -li, --list-installed" "list all installed binaries."
        printf "\e[2m%-35s\e[0m %0s\n" "      --list-installed <package>" "filters all installed binaries."
        printf "%-35s %0s\n" " -sy, --sync" "this synchronizes maya and recipes."
        printf "\e[2m%-35s\e[0m %0s\n" "      --sync all" "this synchronizes all installed packages."
        printf "\e[2m%-35s\e[0m %0s\n" "      --sync <package>" "this synchronizes a specific package."
        printf "%-35s %0s\n" " -in, --install" "install a binary."
        printf "%-35s %0s\n" " -rm, --remove" "remove a binary."
	    printf "\n\e[1mReport bugs to: https://github.com/sakaki91/maya\e[0m\n\n"
    ;;
    "--version"|"-v") printf "maya $MAYA_VERSION\nCopyright (C) by Sakaki, 2026.\nLicense: GNU General Public License version 3 <https://www.gnu.org/licenses/gpl-3.0.en.html>\n" ;;
    "--about"|"-a") binaryExCheck "$2" ; source "$MAYA_TREE/pkg/$2" ; printf "$NAME-$VERSION: $DESCRIPTION\n" ;;
    "--list"|"-l")
		if [[ -z $2 ]]; then
			printf "\e[0;95m$(ls $MAYA_TREE/pkg -p -1)\e[0m\n"
        else
			printf "\e[0;95m$(ls $MAYA_TREE/pkg -p -1 | grep $2)\e[0m\n"
		fi
	;;
	"--list-installed"|"-li") printf "\e[0;95m$(ls $MAYA_TREE/pkg/.info -p -1)\e[0m\n" ;;
	"--clean"|"-cl") rootCheck ; rm -rf /tmp/maya ;;
	"--sync"|"-sy")
        rootCheck
        git clone https://github.com/sakaki91/maya /tmp/maya/maya.source
        /usr/bin/install /tmp/maya/maya.source/maya /usr/local/bin/maya ; /usr/bin/install /tmp/maya/maya.source/{README,LICENSE} /usr/local/share/maya/doc/
        cp -r /tmp/maya/maya.source/{pkg,src} /usr/local/share/maya/
        if [[ $2 == "all" ]]; then
            printf "\e[0;93mWARNING!\e[0m This will update all packages directly from their sources \e[1m(even if there are no updates)\e[0m.\nwould you like to continue? \e[1m(this may take some time)\e[0m\n"
            read -p "[Y/n] " input
            if [[ $input == "Y" || $input == "y" ]]; then
                for installedpkg in /usr/local/share/maya/pkg/.info/*; do
                    INSTALLED_PKG_FILTERED="$(basename $installedpkg)"
                    printf "$INSTALLED_PKG_FILTERED\n" ; source /usr/local/share/maya/pkg/$INSTALLED_PKG_FILTERED
                    dependencieCheck ; install ; echo "INSTALLED_VERSION=$VERSION" > "$MAYA_TREE/pkg/.info/$NAME"
                done
            elif [[ $input == "N" || $input == "n" ]]; then
                printf "\e[0;92mok:\e[0m canceled by the operator.\n"    
            fi
        else
		    binaryExCheck "$2"
		    if [[ ! $(command -v $2) ]]; then
			    printf "\e[0;91merror:\e[0m package not installed.\n"
		    else
			    source "$MAYA_TREE/pkg/$2" ; source "$MAYA_TREE/pkg/.info/$2"
			    if [[ $VERSION != $INSTALLED_VERSION || $INSTALLED_VERSION == "git" ]]; then
				    dependencieCheck ; install ; echo "INSTALLED_VERSION=$VERSION" > "$MAYA_TREE/pkg/.info/$NAME"
			    else
				    printf "\e[0;92mok:\e[0m the latest version is installed.\n"
			    fi
            fi
		fi
	;;
    "--install"|"-in")
		binaryExCheck "$2" ; rootCheck
		mkdir -p /tmp/maya ; source "$MAYA_TREE/pkg/$2"
		dependencieCheck ; install ; echo "INSTALLED_VERSION=$VERSION" > "$MAYA_TREE/pkg/.info/$NAME"
	;;
    "--remove"|"-rm")
		binaryExCheck "$2" ; rootCheck
		source "$MAYA_TREE/pkg/$2" ; remove ; rm -f "$MAYA_TREE/pkg/.info/$NAME"
	;;
    *) printf "\e[0;91merror:\e[0m -h for help\n" ;;
esac
