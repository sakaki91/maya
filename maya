MAYA_VERSION=1.4-1
MAYA_TREE=/usr/local/share/maya

function rootCheck(){
	[[ $EUID != 0 ]] && printf "\e[0;91merror:\e[0m you can't run this without root access.\n" && exit
}

function dependencieCheck(){
	if [[ ! -z $DEPENDENCIES ]]; then
        for dep in "${DEPENDENCIES[@]}"; do
	    	if ! command -v "$dep" >/dev/null 2>&1; then
        	    printf "\e[0;91merror:\033[0m $dep is not installed.\n" && exit
	        fi
        done
    fi
}

function binaryExCheck(){
	[[ -z $1 ]] && printf "\e[0;91merror:\e[0m empty value.\n" && exit
	[[ ! -f "$MAYA_TREE/pkg/$1" ]] && printf "\e[0;91merror:\e[0m the package does not exist.\n" && exit
}

case $1 in
	"--help"|"-h")
		printf "\e[1musage: maya 'operation' [...]\n\e[4moperations:\e[0m\n" 
		printf "%-23s %0s\n" " -h, --help" ": show this message."
	    printf "%-23s %0s\n" " -v, --version" ": shows the version."
        printf "%-23s %0s\n" " -a, --about" ": view the metadata (version, name, and description) of a package."
	    printf "%-23s %0s\n" " -l, --list" ": shows all binaries available for installation."
        printf "%-23s %0s\n" " -li, --list-installed" ": it shows everything that maya has installed."
	    printf "%-23s %0s\n" " -cl, --clean" ": clears the /tmp/maya directory."
        printf "%-23s %0s\n" " -sy, --sync-maya" ": update maya and recipes by pulling directly from the git."
	    printf "%-23s %0s\n" " -in, --install" ": install a binary."
        printf "%-23s %0s\n" " -rm, --remove" ": remove a binary."
	    printf "\n\e[1mReport bugs to: https://github.com/sakaki91/maya\e[0m\n"
    ;;
    "--version"|"-v") printf "maya $MAYA_VERSION\nCopyright (C) by Sakaki, 2026.\nLicense: GNU General Public License version 3 <https://www.gnu.org/licenses/gpl-3.0.en.html>\n" ;;
    "--about"|"-a") binaryExCheck "$2" ; source "$MAYA_TREE/pkg/$2" ; printf "$NAME-$VERSION: $DESCRIPTION\n" ;;
    "--list"|"-l")
		[[ -z $2 ]] && printf "\e[0;95m$(ls $MAYA_TREE/pkg -p -1)\e[0m\n" && exit
		[[ ! -z $2 ]] && printf "\e[0;95m$(ls $MAYA_TREE/pkg -p -1 | grep $2)\e[0m\n" && exit
	;;
	"--list-installed"|"-li") printf "\e[0;92m$(ls $MAYA_TREE/pkg/.info -p -1)\e[0m\n" ;;
	"--clean"|"-cl") rootCheck ; rm -rf /tmp/maya ;;
	"--sync-maya"|"-sy")
		rootCheck
		[[ -d /tmp/maya/maya.source ]] && rm -rf /tmp/maya/maya.source
		git clone https://github.com/sakaki91/maya /tmp/maya/maya.source ; /usr/bin/install /tmp/maya/maya.source/maya /usr/local/bin/maya ; /usr/bin/install /tmp/maya/maya.source/{README,LICENSE} /usr/local/share/maya/doc/ ; cp -r /tmp/maya/maya.source/{pkg,src} /usr/local/share/maya
	;;
    "--install"|"-in")
		binaryExCheck "$2"
		rootCheck
		mkdir -p /tmp/maya
		source "$MAYA_TREE/pkg/$2"
		dependencieCheck
		install
		touch "$MAYA_TREE/pkg/.info/$NAME"
	;;
    "--remove"|"-rm")
		binaryExCheck "$2"
		rootCheck
		source "$MAYA_TREE/pkg/$2"
		remove
		rm -f "$MAYA_TREE/pkg/.info/$NAME"
	;;
    *) printf "\e[0;91merror:\e[0m -h for help\n" ;;
esac
